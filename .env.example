# --- Supabase (leave blank to run in local-only demo mode: data stays in your browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes for Storage uploads, OCR quota and Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (receipt OCR) ---
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL, used for Stripe redirects and magic links
NEXT_PUBLIC_APP_URL=http://localhost:3000
